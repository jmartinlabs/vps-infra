#!/usr/bin/env python3
"""Local simulation for scripts/deploy-test-release (no network, no host)."""
from __future__ import annotations

import hashlib
import io
import json
import os
import runpy
import subprocess
import tarfile
import tempfile
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
module = runpy.run_path(str(ROOT / "scripts" / "deploy-test-release"))
Config = module["Config"]
DeployError = module["DeployError"]
Deployer = module["Deployer"]
identity_from_environment = module["identity_from_environment"]
canonical_image_id = module["canonical_image_id"]
SYSTEMD_START_TIMEOUT = module["SYSTEMD_START_TIMEOUT"]
SYSTEMD_STOP_TIMEOUT = module["SYSTEMD_STOP_TIMEOUT"]
SYSTEMCTL_START_TIMEOUT = module["SYSTEMCTL_START_TIMEOUT"]
SYSTEMCTL_STOP_TIMEOUT = module["SYSTEMCTL_STOP_TIMEOUT"]
SETTLE_TIMEOUT = module["SETTLE_TIMEOUT"]


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def write_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
    path.chmod(0o600)


def tar_bytes(members, dirs=()) -> bytes:
    buffer = io.BytesIO()
    with tarfile.open(fileobj=buffer, mode="w") as archive:
        for name in dirs:
            info = tarfile.TarInfo(name)
            info.type = tarfile.DIRTYPE
            info.mode = 0o755
            archive.addfile(info)
        for name, data in members:
            info = tarfile.TarInfo(name)
            info.size = len(data)
            info.mode = 0o644
            archive.addfile(info, io.BytesIO(data))
    return buffer.getvalue()


def bundle(source: str, app_id: str, frontend: dict, schema: int = 27,
           data_contract: str = "e4.11-v27", tamper=None, dirs=(),
           version: str = "0.1.0", metadata_version: str | None = None,
           metadata_tag: str | None = None) -> bytes:
    contracts = {
        "schema": schema,
        "data": data_contract,
        "authentication": "argon2id-aesgcm-totp-session-v1",
    }
    digest = "sha256:" + "a" * 64
    oci = tar_bytes([
        ("index.json", json.dumps({"schemaVersion": 2, "manifests": [
            {"digest": digest, "mediaType": "application/vnd.oci.image.manifest.v1+json"}]}).encode()),
        ("oci-layout", b'{"imageLayoutVersion":"1.0.0"}'),
    ])
    manifest = {
        "format": 1,
        "inputs": {"source": source, "contracts": contracts},
        "image": app_id,
        "oci_manifest_digest": digest,
        "oci_archive_sha256": sha256(oci),
        "seed": {
            "image": "sha256:" + "b" * 64,
            "source": source,
            "contracts": contracts,
            "oci_manifest_digest": "sha256:" + "c" * 64,
        },
        "frontend_files": {name: sha256(body) for name, body in frontend.items()},
    }
    manifest_bytes = (json.dumps(manifest, indent=2, sort_keys=True) + "\n").encode()
    manifest_sha = sha256(manifest_bytes)
    metadata = {
        "environment": "test",
        "version": metadata_version or version,
        "tag": metadata_tag or f"deploy-test-v{version}",
        "release_sha": source,
        "manifest_sha256": manifest_sha,
        "qa_reference": "https://example.invalid/checks/" + source,
        "workflow_run_id": "1",
    }
    files = [
        ("manifest.json", manifest_bytes),
        ("manifest.sha256", (manifest_sha + "\n").encode()),
        ("image.oci.tar", oci),
        ("deploy.json", (json.dumps(metadata, indent=2, sort_keys=True) + "\n").encode()),
    ] + [("frontend/" + name, body) for name, body in sorted(frontend.items())]
    sums = "".join(f"{sha256(body)}  ./{name}\n" for name, body in files).encode()
    if tamper:
        files = [(name, tamper.get(name, body)) for name, body in files]
    files.append(("SHA256SUMS", sums))
    return tar_bytes(files, dirs)


INDEX = b'<script src="/theme-boot.js"></script><link rel="stylesheet" href="/themes.css">\n'
THEMES = {
    "index.html": INDEX,
    "theme-boot.js": b"document.documentElement.dataset.theme='dark-s';\n",
    "themes.css": b":root{--bg:#141414}\n",
}


class FakeRunner:
    def __init__(self, source: str, app_id: str):
        self.source = source
        self.app_id = app_id
        self.reported_id = app_id
        self.attempts = 0
        self.fail_first = False
        self.fail_all = False
        self.timeout_first = False
        self.timeout_stop = False
        self.timeout_is_active = False
        self.stubborn_unit = False
        self.fail_smoke = False
        self.stopped = False
        self.events = []
        self.timeouts = {}

    def run(self, args, check=True, timeout=None):
        command = " ".join(args)
        self.events.append(command)
        self.timeouts[command] = timeout
        code, out, err = 0, "", ""
        if command.startswith("podman load "):
            pass
        elif command.startswith("podman image inspect --format {{.Id}}"):
            out = self.reported_id + "\n"
        elif "org.opencontainers.image.revision" in command:
            out = self.source + "\n"
        elif command == "systemctl --user daemon-reload":
            pass
        elif command.startswith("systemctl --user restart "):
            self.attempts += 1
            self.stopped = False
            if self.timeout_first and self.attempts == 1:
                raise DeployError(f"command timed out: {command}")
            if self.fail_all or (self.fail_first and self.attempts == 1):
                code, err = 1, "restart failed"
        elif command.startswith("systemctl --user stop "):
            if self.timeout_stop:
                raise DeployError(f"command timed out: {command}")
            self.stopped = True
        elif command.startswith("systemctl --user reset-failed "):
            pass
        elif command.startswith("systemctl --user is-active "):
            if self.timeout_is_active:
                raise DeployError(f"command timed out: {command}")
            if self.stubborn_unit or not self.stopped:
                out = "active\n"
            else:
                out = "inactive\n"
        elif command.startswith("curl "):
            if self.fail_all or (self.attempts == 1 and self.fail_first) \
                    or (self.fail_smoke and self.attempts == 1):
                code, err = 1, "health failed"
            elif "127.0.0.1:18082/api/health" in command:
                out = '{"ok":true}\n'
            elif "127.0.0.1:18082/api/saldos" in command:
                out = "401"
            else:
                code, err = 1, "unexpected curl"
        else:
            code, err = 1, f"unexpected command: {command}"
        result = subprocess.CompletedProcess(args, code, out, err)
        if check and code:
            raise DeployError(f"command failed ({code}): {command}\n{err}")
        return result


class DeployTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.data = self.root / "data"
        self.web = self.root / "web"
        self.unit_dir = self.root / "units"
        self.state_file = self.root / "current-release.json"
        self.last_deploy = self.root / "last-deploy.json"
        self.lock_file = self.root / "update.lock"
        for path in (self.data / "state", self.web / "releases", self.unit_dir):
            path.mkdir(parents=True, exist_ok=True)
        (self.web / "releases").chmod(0o2750)
        write_json(self.data / "test-instance.json", {
            "schema_version": 27, "environment": "test",
            "public_origin": "https://test.myfinanzas.pp.ua"})
        write_json(self.data / "seed-manifest.json",
                   {"source": {"schema": 27, "data_contract": "e4.11-v27"}})
        (self.data / "state" / "database.sqlite").write_text("fixture")
        (self.data / "state" / "auth.key").write_text("fixture")
        self.config = Config(
            data_root=self.data, web_root=self.web, unit_dir=self.unit_dir,
            state_file=self.state_file, last_deploy_file=self.last_deploy,
            lock_file=self.lock_file,
            health_url="http://127.0.0.1:18082/api/health",
            protected_url="http://127.0.0.1:18082/api/saldos",
            timeout_seconds=5,
        )
        self.source = "d" * 40
        self.app_id = "sha256:" + "f" * 64
        self.runner = FakeRunner(self.source, self.app_id)
        ticks = iter(range(1000))
        self.deployer = Deployer(self.config, runner=self.runner,
                                 sleep=lambda _: None, clock=lambda: next(ticks))

    def deploy(self, payload: bytes, actor="octocat", version="0.1.0"):
        return self.deployer.deploy(io.BytesIO(payload), actor, version)

    def test_deploy_writes_unit_frontend_and_state(self):
        self.assertEqual(self.deploy(bundle(self.source, self.app_id, THEMES)), 0)
        unit = (self.unit_dir / "myfinanzas-test-api.container").read_text()
        self.assertIn("Image=" + self.app_id, unit)
        current = self.web / "current"
        self.assertTrue((current / "themes.css").is_file())
        self.assertTrue((current / "theme-boot.js").is_file())
        state = json.loads(self.state_file.read_text())
        self.assertEqual(state["source"], self.source)
        self.assertEqual(state["actor"], "octocat")
        self.assertEqual(state["version"], "0.1.0")
        self.assertEqual(state["tag"], "deploy-test-v0.1.0")
        self.assertEqual(json.loads(self.last_deploy.read_text())["result"], "ok")

    def test_missing_index_asset_is_rejected_before_changes(self):
        bad = {"index.html": INDEX, "assets/app.js": b"console.log(1)\n"}
        with self.assertRaises(DeployError) as caught:
            self.deploy(bundle(self.source, self.app_id, bad))
        self.assertIn("themes.css", str(caught.exception))
        self.assertFalse((self.unit_dir / "myfinanzas-test-api.container").exists())
        self.assertFalse((self.web / "current").exists())
        self.assertEqual(json.loads(self.last_deploy.read_text())["result"], "rejected")

    def test_contract_change_is_rejected(self):
        with self.assertRaises(DeployError):
            self.deploy(bundle(self.source, self.app_id, THEMES, schema=28,
                               data_contract="e4.12-v28"))
        self.assertFalse((self.unit_dir / "myfinanzas-test-api.container").exists())

    def test_failed_smoke_rolls_back(self):
        old = self.web / "releases" / "old"
        old.mkdir()
        (old / "index.html").write_text("old")
        (self.web / "current").symlink_to(Path("releases") / "old")
        (self.unit_dir / "myfinanzas-test-api.container").write_text("old unit\n")
        self.runner.fail_first = True
        with self.assertRaises(DeployError):
            self.deploy(bundle(self.source, self.app_id, THEMES))
        self.assertEqual(
            (self.unit_dir / "myfinanzas-test-api.container").read_text(), "old unit\n")
        self.assertEqual(os.readlink(self.web / "current"), "releases/old")
        self.assertFalse(self.state_file.exists())
        events = self.runner.events
        stop = events.index("systemctl --user stop myfinanzas-test-api.service")
        reset = events.index("systemctl --user reset-failed myfinanzas-test-api.service")
        restarts = [index for index, command in enumerate(events)
                    if command.startswith("systemctl --user restart ")]
        self.assertEqual(len(restarts), 2)
        self.assertLess(stop, restarts[1])
        self.assertLess(reset, restarts[1])

    def test_same_version_and_source_is_a_noop(self):
        payload = bundle(self.source, self.app_id, THEMES)
        self.assertEqual(self.deploy(payload), 0)
        self.assertEqual(self.deploy(payload), 0)
        self.assertEqual(json.loads(self.last_deploy.read_text())["result"], "noop")

    def test_same_version_from_another_source_is_rejected(self):
        self.assertEqual(self.deploy(bundle(self.source, self.app_id, THEMES)), 0)
        other = "e" * 40
        with self.assertRaises(DeployError) as caught:
            self.deploy(bundle(other, self.app_id, THEMES))
        self.assertIn("another source", str(caught.exception))

    def test_missing_version_is_a_clean_error(self):
        code = module["main"](["--bundle", str(self.root / "missing.tar")])
        self.assertEqual(code, 2)
        self.assertEqual(identity_from_environment("deploy:octocat"), ("unknown", None))

    def test_deploy_metadata_must_match_the_order(self):
        payload = bundle(self.source, self.app_id, THEMES, metadata_version="9.9.9")
        with self.assertRaises(DeployError) as caught:
            self.deploy(payload)
        self.assertIn("version/tag", str(caught.exception))
        self.assertFalse((self.unit_dir / "myfinanzas-test-api.container").exists())

    def test_failed_rollback_stops_the_unit(self):
        old = self.web / "releases" / "old"
        old.mkdir()
        (old / "index.html").write_text("old")
        (self.web / "current").symlink_to(Path("releases") / "old")
        (self.unit_dir / "myfinanzas-test-api.container").write_text("old unit\n")
        self.runner.fail_all = True
        with self.assertRaises(DeployError):
            self.deploy(bundle(self.source, self.app_id, THEMES))
        self.assertTrue(self.runner.stopped)
        self.assertEqual(
            (self.unit_dir / "myfinanzas-test-api.container").read_text(), "old unit\n")
        self.assertFalse(self.state_file.exists())

    def test_bundle_path_escape_is_rejected(self):
        payload = tar_bytes([
            ("manifest.json", b"{}"),
            ("../escape", b"x"),
        ])
        with self.assertRaises(DeployError):
            self.deploy(payload)
        self.assertFalse((self.root / "escape").exists())

    def test_checksum_mismatch_is_rejected(self):
        # Same manifest and SHA256SUMS, different bytes on the wire.
        payload = bundle(self.source, self.app_id, THEMES,
                         tamper={"frontend/themes.css": b":root{--bg:#000}\n"})
        with self.assertRaises(DeployError) as caught:
            self.deploy(payload)
        self.assertIn("SHA256SUMS", str(caught.exception))
        self.assertFalse((self.unit_dir / "myfinanzas-test-api.container").exists())

    def test_image_id_with_sha256_prefix_is_accepted(self):
        self.runner.reported_id = self.app_id
        self.assertEqual(self.deploy(bundle(self.source, self.app_id, THEMES)), 0)
        unit = (self.unit_dir / "myfinanzas-test-api.container").read_text()
        self.assertIn("Image=" + self.app_id, unit)

    def test_image_id_without_sha256_prefix_is_accepted(self):
        # Podman 5 prints the ID without the sha256: prefix.
        self.runner.reported_id = self.app_id.removeprefix("sha256:")
        self.assertEqual(self.deploy(bundle(self.source, self.app_id, THEMES)), 0)
        unit = (self.unit_dir / "myfinanzas-test-api.container").read_text()
        self.assertIn("Image=" + self.app_id, unit)

    def test_image_id_mismatch_is_rejected(self):
        self.runner.reported_id = "sha256:" + "9" * 64
        with self.assertRaises(DeployError) as caught:
            self.deploy(bundle(self.source, self.app_id, THEMES))
        self.assertIn("does not match", str(caught.exception))
        self.assertFalse((self.unit_dir / "myfinanzas-test-api.container").exists())

    def test_invalid_image_id_is_rejected(self):
        self.runner.reported_id = "not-an-image-id"
        with self.assertRaises(DeployError) as caught:
            self.deploy(bundle(self.source, self.app_id, THEMES))
        self.assertIn("invalid image ID", str(caught.exception))
        self.assertFalse((self.unit_dir / "myfinanzas-test-api.container").exists())

    def test_canonical_image_id_matrix(self):
        hex_id = "a" * 64
        self.assertEqual(canonical_image_id("sha256:" + hex_id), "sha256:" + hex_id)
        self.assertEqual(canonical_image_id(hex_id), "sha256:" + hex_id)
        self.assertEqual(canonical_image_id("  sha256:" + hex_id + "\n"), "sha256:" + hex_id)
        for invalid in ("", "   ", "sha256:", hex_id[:-1], hex_id + "0",
                        "sha256:sha256:" + hex_id, "SHA256:" + hex_id,
                        hex_id.upper(), hex_id[:32] + " " + hex_id[32:]):
            with self.assertRaises(DeployError):
                canonical_image_id(invalid)

    def test_unit_declares_bounded_start_and_stop_timeouts(self):
        self.assertEqual(self.deploy(bundle(self.source, self.app_id, THEMES)), 0)
        unit = (self.unit_dir / "myfinanzas-test-api.container").read_text()
        self.assertIn(f"TimeoutStartSec={SYSTEMD_START_TIMEOUT}s", unit)
        self.assertIn(f"TimeoutStopSec={SYSTEMD_STOP_TIMEOUT}s", unit)
        self.assertGreater(SYSTEMD_START_TIMEOUT, 0)

    def test_restart_client_outlives_systemd_start_timeout(self):
        self.assertEqual(self.deploy(bundle(self.source, self.app_id, THEMES)), 0)
        restart = "systemctl --user restart myfinanzas-test-api.service"
        self.assertEqual(self.runner.timeouts[restart], SYSTEMCTL_START_TIMEOUT)
        self.assertGreater(SYSTEMCTL_START_TIMEOUT,
                           SYSTEMD_START_TIMEOUT + SYSTEMD_STOP_TIMEOUT)
        self.assertGreater(SYSTEMCTL_STOP_TIMEOUT, SYSTEMD_STOP_TIMEOUT)

    def test_slow_start_within_budget_does_not_roll_back(self):
        # The 68 s pre-create delay of the incident fits inside the systemd
        # budget; the fake runner does not spend real time, but a normal success
        # must not trigger recovery.
        self.assertGreater(SYSTEMD_START_TIMEOUT, 68)
        self.assertEqual(self.deploy(bundle(self.source, self.app_id, THEMES)), 0)
        self.assertNotIn("systemctl --user stop myfinanzas-test-api.service",
                         self.runner.events)

    def test_start_timeout_settles_before_restoring(self):
        old = self.web / "releases" / "old"
        old.mkdir()
        (old / "index.html").write_text("old")
        (self.web / "current").symlink_to(Path("releases") / "old")
        (self.unit_dir / "myfinanzas-test-api.container").write_text("old unit\n")
        self.runner.timeout_first = True
        with self.assertRaises(DeployError) as caught:
            self.deploy(bundle(self.source, self.app_id, THEMES))
        self.assertIn("timed out", str(caught.exception))
        events = self.runner.events
        stop = events.index("systemctl --user stop myfinanzas-test-api.service")
        reset = events.index("systemctl --user reset-failed myfinanzas-test-api.service")
        restarts = [index for index, command in enumerate(events)
                    if command.startswith("systemctl --user restart ")]
        self.assertEqual(len(restarts), 2)
        self.assertLess(stop, restarts[1])
        self.assertLess(reset, restarts[1])
        self.assertEqual(
            (self.unit_dir / "myfinanzas-test-api.container").read_text(), "old unit\n")
        self.assertEqual(os.readlink(self.web / "current"), "releases/old")
        self.assertFalse(self.state_file.exists())

    def test_smoke_failure_rolls_back_without_leaving_the_new_unit(self):
        old = self.web / "releases" / "old"
        old.mkdir()
        (old / "index.html").write_text("old")
        (self.web / "current").symlink_to(Path("releases") / "old")
        (self.unit_dir / "myfinanzas-test-api.container").write_text("old unit\n")
        self.runner.fail_smoke = True
        with self.assertRaises(DeployError):
            self.deploy(bundle(self.source, self.app_id, THEMES))
        self.assertEqual(
            (self.unit_dir / "myfinanzas-test-api.container").read_text(), "old unit\n")
        self.assertEqual(os.readlink(self.web / "current"), "releases/old")
        self.assertFalse(self.state_file.exists())
        events = self.runner.events
        stop = events.index("systemctl --user stop myfinanzas-test-api.service")
        restarts = [index for index, command in enumerate(events)
                    if command.startswith("systemctl --user restart ")]
        self.assertEqual(len(restarts), 2)
        self.assertLess(stop, restarts[1])

    def test_state_write_failure_rolls_back(self):
        old = self.web / "releases" / "old"
        old.mkdir()
        (old / "index.html").write_text("old")
        (self.web / "current").symlink_to(Path("releases") / "old")
        (self.unit_dir / "myfinanzas-test-api.container").write_text("old unit\n")

        def fail_write(*_args, **_kwargs):
            raise OSError("disk full")

        self.deployer.write_state = fail_write
        with self.assertRaises(OSError):
            self.deploy(bundle(self.source, self.app_id, THEMES))
        self.assertEqual(
            (self.unit_dir / "myfinanzas-test-api.container").read_text(), "old unit\n")
        self.assertEqual(os.readlink(self.web / "current"), "releases/old")
        self.assertFalse(self.state_file.exists())
        self.assertIn("systemctl --user stop myfinanzas-test-api.service",
                      self.runner.events)

    def test_settle_survives_stop_timeout_and_still_restores(self):
        old = self.web / "releases" / "old"
        old.mkdir()
        (old / "index.html").write_text("old")
        (self.web / "current").symlink_to(Path("releases") / "old")
        (self.unit_dir / "myfinanzas-test-api.container").write_text("old unit\n")
        self.runner.fail_first = True
        self.runner.timeout_stop = True
        self.runner.stubborn_unit = True
        with self.assertRaises(DeployError) as caught:
            self.deploy(bundle(self.source, self.app_id, THEMES))
        self.assertIn("did not settle", str(caught.exception))
        self.assertEqual(
            (self.unit_dir / "myfinanzas-test-api.container").read_text(), "old unit\n")
        self.assertEqual(os.readlink(self.web / "current"), "releases/old")
        self.assertFalse(self.state_file.exists())
        stops = [command for command in self.runner.events
                 if command.startswith("systemctl --user stop ")]
        self.assertGreaterEqual(len(stops), 2)
        restarts = [command for command in self.runner.events
                    if command.startswith("systemctl --user restart ")]
        self.assertEqual(len(restarts), 1)

    def test_settle_survives_is_active_timeout_and_still_restores(self):
        old = self.web / "releases" / "old"
        old.mkdir()
        (old / "index.html").write_text("old")
        (self.web / "current").symlink_to(Path("releases") / "old")
        (self.unit_dir / "myfinanzas-test-api.container").write_text("old unit\n")
        self.runner.fail_first = True
        self.runner.timeout_is_active = True
        with self.assertRaises(DeployError) as caught:
            self.deploy(bundle(self.source, self.app_id, THEMES))
        self.assertIn("did not settle", str(caught.exception))
        self.assertEqual(
            (self.unit_dir / "myfinanzas-test-api.container").read_text(), "old unit\n")
        self.assertEqual(os.readlink(self.web / "current"), "releases/old")
        self.assertFalse(self.state_file.exists())
        stops = [command for command in self.runner.events
                 if command.startswith("systemctl --user stop ")]
        self.assertGreaterEqual(len(stops), 2)

    def test_unit_that_never_settles_does_not_start_recovery(self):
        old = self.web / "releases" / "old"
        old.mkdir()
        (old / "index.html").write_text("old")
        (self.web / "current").symlink_to(Path("releases") / "old")
        (self.unit_dir / "myfinanzas-test-api.container").write_text("old unit\n")
        self.runner.fail_first = True
        self.runner.stubborn_unit = True
        with self.assertRaises(DeployError) as caught:
            self.deploy(bundle(self.source, self.app_id, THEMES))
        self.assertIn("did not settle", str(caught.exception))
        restarts = [command for command in self.runner.events
                    if command.startswith("systemctl --user restart ")]
        self.assertEqual(len(restarts), 1)
        stops = [command for command in self.runner.events
                 if command.startswith("systemctl --user stop ")]
        self.assertGreaterEqual(len(stops), 2)
        self.assertEqual(
            (self.unit_dir / "myfinanzas-test-api.container").read_text(), "old unit\n")
        self.assertFalse(self.state_file.exists())

    def test_bundle_directory_entries_are_allowed(self):
        payload = bundle(self.source, self.app_id, THEMES,
                         dirs=("frontend/", "frontend/assets/"))
        self.assertEqual(self.deploy(payload), 0)

    def test_actor_and_version_come_from_ssh_command(self):
        self.assertEqual(identity_from_environment("deploy:octocat:1.2.3"), ("octocat", "1.2.3"))
        self.assertEqual(identity_from_environment("deploy:octocat"), ("unknown", None))
        self.assertEqual(identity_from_environment("rm -rf /"), ("unknown", None))
        self.assertEqual(identity_from_environment(None), ("unknown", None))


if __name__ == "__main__":
    unittest.main(verbosity=2)
