  for token in ('publication-01..10', 'continuity-01..07', 'closure-01..03',
                'proactive-01..09',
                'does not prove that a real client'):
   with self.subTest(token=token):
    self.assertIn(token, original)
    try:
     p.write_text(original.replace(token, 'REMOVED'))
     self.assertRule('agent-evals')
    finally:
     p.write_text(original)
 def test_proactive_planning_contract(self):
  cases = (
   ('specs/methodology/epic-orchestration.md', '## Proactive planning (look-ahead)'),
   ('specs/methodology/epic-orchestration.md', 'Do not wait for an unnecessary instruction'),
   ('specs/methodology/epic-orchestration.md', 'Preparation never promotes a draft'),
   ('specs/methodology/epic-orchestration.md', 'authorizes DEV'),
   ('specs/methodology/epic-orchestration.md', 'starts QA verification'),
   ('specs/methodology/epic-orchestration.md', 'merges or deploys'),
   ('specs/methodology/epic-orchestration.md', 'no artificial task'),
   ('specs/methodology/epic-orchestration.md', 'no second scheduler'),
   ('specs/methodology/epic-orchestration.md', 'Replan when a task completes'),
   ('specs/methodology/epic-orchestration.md', 'advance the next independent ready item instead of idling'),
   ('.agents/skills/orchestrate/SKILL.md', 'Never create busywork'),
   ('.agents/skills/orchestrate/SKILL.md', 'next roadmap work and dependencies identified'),
   ('.agents/skills/orchestrate/SKILL.md', 'a work packet for already authorized DEV, or QA test design'),
   ('AGENTS.md', 'deja una siguiente acción verificable'),
  )
  for name, token in cases:
   with self.subTest(name=name, token=token):
    p = self.root/name; original = p.read_text()
    self.assertIn(token, original)
    try:
     p.write_text(original.replace(token, 'REMOVED'))
     self.assertRule('proactive-planning')
    finally:
     p.write_text(original)
 def test_proactive_scenarios_required(self):
  p = self.root/'evals/scenarios.json'; data = json.loads(p.read_text())
  data['cases'] = [c for c in data['cases'] if not str(c.get('id','')).startswith('proactive-')]
  p.write_text(json.dumps(data))
  self.assertRule('agent-evals')

class FixtureIsolationTests(unittest.TestCase):
 def setUp(self):
  temp=tempfile.TemporaryDirectory(); self.addCleanup(temp.cleanup)
  self.tmp=Path(temp.name)
 def git(self,root,*args):
  subprocess.run(['git','-c','user.name=Test','-c','user.email=test@example.invalid','-C',str(root),*args],check=True,capture_output=True)
 def repository(self,name='source'):
  root=self.tmp/name; root.mkdir(); self.git(root,'init','-q'); return root
 def commit(self,root):
  self.git(root,'add','-A'); self.git(root,'commit','-q','-m','initial')
 def test_untracked_file_excluded(self):
  source=self.repository(); (source/'README.md').write_text('# tracked\n'); self.commit(source)
  (source/'specs').mkdir(); (source/'specs/local.md').write_text(MACHINE_PATH+'\n')
  fixture=build_fixture(source,self.tmp/'fixture')
  self.assertFalse((fixture/'specs/local.md').exists())
  self.assertFalse(any(e.startswith('portability:') for e in validate(fixture)))
 def test_uncommitted_change_preserved(self):
  source=self.repository(); (source/'README.md').write_text('HEAD content\n'); self.commit(source)
  (source/'README.md').write_text('working content\n')
  fixture=build_fixture(source,self.tmp/'fixture')
  self.assertEqual((fixture/'README.md').read_text(),'working content\n')
 def test_missing_tracked_file_fails(self):
  source=self.repository(); (source/'README.md').write_text('# x\n'); (source/'gone.md').write_text('# gone\n'); self.commit(source)
  (source/'gone.md').unlink()
  with self.assertRaises(RuntimeError) as caught: build_fixture(source,self.tmp/'fixture')
  self.assertIn('gone.md',str(caught.exception))
 def test_without_git_copies_tree_and_reports_limitation(self):
  source=self.tmp/'export'; (source/'__pycache__').mkdir(parents=True); (source/'artifacts').mkdir()
  (source/'keep.md').write_text('# keep\n'); (source/'__pycache__/x.pyc').write_text('x'); (source/'artifacts/log').write_text('x')
  out=io.StringIO()
  with contextlib.redirect_stdout(out): fixture=build_fixture(source,self.tmp/'fixture')
  self.assertEqual(out.getvalue(),NO_GIT_NOTICE+'\n')
  self.assertTrue((fixture/'keep.md').is_file()); self.assertFalse((fixture/'__pycache__').exists()); self.assertFalse((fixture/'artifacts').exists())
 def test_tracked_machine_path_still_fails_portability(self):
  source=self.repository(); (source/'README.md').write_text(MACHINE_PATH+'\n'); self.commit(source)
  fixture=build_fixture(source,self.tmp/'fixture')
  self.assertTrue((fixture/'README.md').is_file())
  self.assertTrue(any(e.startswith('portability:') for e in validate(fixture)))
 def test_git_unavailable_does_not_fallback(self):
  source=self.repository(); (source/'README.md').write_text('# x\n'); self.commit(source)
  (source/'local.md').write_text(MACHINE_PATH+'\n'); (self.tmp/'empty-bin').mkdir()
  path=os.environ.get('PATH'); os.environ['PATH']=str(self.tmp/'empty-bin')
  out=io.StringIO()
  try:
   with contextlib.redirect_stdout(out), self.assertRaises(RuntimeError) as caught: build_fixture(source,self.tmp/'fixture')
  finally:
   if path is None: os.environ.pop('PATH',None)
   else: os.environ['PATH']=path
  self.assertIn('git is unavailable',str(caught.exception)); self.assertNotIn(NO_GIT_NOTICE,out.getvalue()); self.assertFalse((self.tmp/'fixture').exists())
 def test_worktree_git_file_copies_tracked_content(self):
  source=self.repository(); (source/'README.md').write_text('HEAD content\n'); self.commit(source)
  linked=self.tmp/'linked'; self.git(source,'worktree','add','-q','-b','linked-branch',str(linked))
  (linked/'README.md').write_text('working content\n')
  self.assertTrue((linked/'.git').is_file())
  out=io.StringIO()
  with contextlib.redirect_stdout(out): fixture=build_fixture(linked,self.tmp/'fixture')
  self.assertNotIn(NO_GIT_NOTICE,out.getvalue())
  self.assertEqual((fixture/'README.md').read_text(),'working content\n')
 def test_ls_files_failure_does_not_fallback(self):
  source=self.tmp/'broken'; source.mkdir(); (source/'.git').write_text('not a gitdir\n')
  (source/'local.md').write_text(MACHINE_PATH+'\n')
  out=io.StringIO()
  with contextlib.redirect_stdout(out), self.assertRaises(RuntimeError) as caught: build_fixture(source,self.tmp/'fixture')
  self.assertIn('git ls-files failed',str(caught.exception))
  self.assertNotIn(NO_GIT_NOTICE,out.getvalue()); self.assertFalse((self.tmp/'fixture').exists())
class LifecycleBehaviorTests(unittest.TestCase):
 """Reference Git invariants for the documented cleanup sequence.

  These tests exercise isolated fixtures, not the coordinator's live resources.
  """
 def setUp(self):
  temp=tempfile.TemporaryDirectory(); self.addCleanup(temp.cleanup)
  self.tmp=Path(temp.name)
 def git(self,root,*args,check=True):
  return subprocess.run(['git','-c','user.name=Test','-c','user.email=test@example.invalid',
    '-C',str(root),*args],check=check,capture_output=True,text=True)
 def repository(self):
  root=self.tmp/'repo'; root.mkdir()
  self.git(root,'init','-q'); (root/'README.md').write_text('# base\n')
  self.git(root,'add','-A'); self.git(root,'commit','-qm','base')
  self.default_branch=self.git(root,'symbolic-ref','--short','HEAD').stdout.strip()
  return root
 def add_worktree(self,root,branch,name):
  path=self.tmp/name
  self.git(root,'worktree','add','-q','-b',branch,str(path))
  return path
 def test_clean_merged_worktree_and_branch_can_be_removed(self):
  root=self.repository(); worktree=self.add_worktree(root,'feature-merged','wt-merged')
  (worktree/'feature.txt').write_text('feature\n')
  self.git(worktree,'add','-A'); self.git(worktree,'commit','-qm','feature')
  self.git(root,'merge','--no-ff','feature-merged','-qm','merge feature')
  self.assertEqual(self.git(root,'worktree','remove',str(worktree),check=False).returncode,0)
  self.assertFalse(worktree.exists())
  self.assertEqual(self.git(root,'branch','-d','feature-merged',check=False).returncode,0)
  self.assertNotIn('feature-merged',self.git(root,'branch','--list').stdout)
 def test_dirty_worktree_is_preserved(self):
  root=self.repository(); worktree=self.add_worktree(root,'feature-dirty','wt-dirty')
  (worktree/'pending.txt').write_text('pending\n')
  self.assertNotEqual(self.git(root,'worktree','remove',str(worktree),check=False).returncode,0)
  self.assertTrue(worktree.exists())
 def test_unmerged_branch_is_preserved(self):
  root=self.repository(); self.git(root,'branch','feature-unmerged')
  self.git(root,'checkout','-q','feature-unmerged')
  (root/'later.txt').write_text('later\n')
  self.git(root,'add','-A'); self.git(root,'commit','-qm','unmerged')
  self.git(root,'checkout','-q',self.default_branch)
  self.assertNotEqual(self.git(root,'branch','-d','feature-unmerged',check=False).returncode,0)
  self.assertIn('feature-unmerged',self.git(root,'branch','--list').stdout)
 def test_other_worktree_is_preserved(self):
  root=self.repository(); first=self.add_worktree(root,'feature-one','wt-one')
  second=self.add_worktree(root,'feature-two','wt-two')
  self.assertEqual(self.git(root,'worktree','remove',str(first),check=False).returncode,0)
  self.assertFalse(first.exists()); self.assertTrue(second.exists())
 def test_untracked_handoff_can_be_removed_after_consolidation(self):
  root=self.repository(); (root/'specs').mkdir()
  handoff=root/'specs/session-handoff.md'; handoff.write_text('temporary\n')
  (root/'specs/progress.md').write_text('durable state\n')
  handoff.unlink()
  self.assertFalse(handoff.exists())
  self.assertTrue((root/'specs/progress.md').exists())
 def test_incomplete_restoration_preserves_handoff(self):
  root=self.repository(); (root/'specs').mkdir()
  handoff=root/'specs/session-handoff.md'; handoff.write_text('temporary\n')
  self.assertTrue(handoff.exists())
 def test_no_temporary_handoff_is_normal(self):
  root=self.repository(); (root/'specs').mkdir()
  handoff=root/'specs/session-handoff.md'
  (root/'specs/progress.md').write_text('durable state\n')
  self.git(root,'add','-A'); self.git(root,'commit','-qm','durable state')
  if handoff.exists(): handoff.unlink()
  self.assertFalse(handoff.exists())
  self.assertEqual(self.git(root,'status','--short').stdout,'')
 def test_tracked_handoff_removal_is_a_normal_worktree_change(self):
  root=self.repository(); (root/'specs').mkdir()
  handoff=root/'specs/session-handoff.md'; handoff.write_text('temporary\n')
  self.git(root,'add','-A'); self.git(root,'commit','-qm','add handoff')
  self.git(root,'rm','-q','specs/session-handoff.md')
  self.assertIn('D  specs/session-handoff.md',self.git(root,'status','--short').stdout)
if __name__=='__main__': unittest.main(verbosity=2)
