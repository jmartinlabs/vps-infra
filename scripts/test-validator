 def test_execution_mode_policy(self):
  cases=(
   ('specs/methodology/dynamic-agents.md','## Execution mode: direct, foreground, background'),
   ('specs/methodology/dynamic-agents.md','**Direct (coordinator).**'),
   ('specs/methodology/dynamic-agents.md','**Foreground subagent.**'),
   ('specs/methodology/dynamic-agents.md','**Background subagent.**'),
   ('specs/methodology/dynamic-agents.md','verified client support'),
   ('specs/methodology/dynamic-agents.md',"Releasing the coordinator's turn"),
   ('specs/methodology/dynamic-agents.md','Promise no background persistence'),
   ('specs/methodology/dynamic-agents.md','Never claim a subagent'),
   ('.agents/skills/orchestrate/SKILL.md','execution mode adaptively'),
   ('.agents/skills/orchestrate/SKILL.md','coordinator availability'),
   ('.agents/skills/orchestrate/SKILL.md','background persistence'),
  )
  for name, token in cases:
   with self.subTest(name=name, token=token):
    p=self.root/name; original=p.read_text()
    self.assertIn(token, original)
    try:
     p.write_text(original.replace(token, 'REMOVED'))
     self.assertRule('execution-mode')
    finally:
     p.write_text(original)
 def test_execution_mode_scenarios(self):
