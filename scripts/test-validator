 def test_delegation_preference(self):
  cases=(
   ('specs/methodology/dynamic-agents.md','## Delegation preference'),
   ('specs/methodology/dynamic-agents.md','one executor per task'),
   ('specs/methodology/dynamic-agents.md','Never create artificial agents'),
   ('.agents/skills/orchestrate/SKILL.md','Prefer a specialist for substantial'),
   ('.agents/skills/orchestrate/SKILL.md','one executor per task'),
   ('.agents/skills/orchestrate/SKILL.md','never invent agents'),
   ('specs/methodology/epic-orchestration.md','one executor per task'),
  )
  for name, token in cases:
   with self.subTest(name=name, token=token):
    p=self.root/name; original=p.read_text()
    self.assertIn(token, original)
    try:
     p.write_text(original.replace(token, 'REMOVED'))
     self.assertRule('delegation-preference')
    finally:
     p.write_text(original)
 def test_thin_adapters(self):
  cases=(('.opencode/agents/functional.md','opencode'),('.opencode/agents/implementation.md','opencode'),
         ('.opencode/agents/infrastructure.md','opencode'),('.claude/agents/functional.md','claude'),
         ('.claude/agents/implementation.md','claude'),('.claude/agents/infrastructure.md','claude'))
  for name, rule in cases:
   with self.subTest(name=name):
    p=self.root/name; original=p.read_text()
    try:
     p.write_text(original+'\n'+'\n'.join(['Duplicated role rule']*10)+'\n')
     self.assertRule(rule)
    finally:
     p.write_text(original)
