        completed, payload = self.fx.run(
            request=request,
            state={"environment": "prod", "installed": None, "lock": None},
            evidence=self.fx.prod_evidence(request),
        )
        self.assertEqual(completed.returncode, 2)
        self.assertBlocked(payload, "APPROVAL_SHA_MISMATCH")

    def test_prod_self_approval(self) -> None:
        request = self.fx.prod_request()
        request["approval"]["reviewer"] = request["actor"]
        completed, payload = self.fx.run(
            request=request,
            state={"environment": "prod", "installed": None, "lock": None},
            evidence=self.fx.prod_evidence(request),
        )
        self.assertEqual(completed.returncode, 2)
        self.assertBlocked(payload, "APPROVAL_SELF_REVIEW")

    def test_simulated_ci_failure(self) -> None:
        evidence = copy.deepcopy(self.fx.evidence)
        evidence["ci"]["status"] = "failure"
        completed, payload = self.fx.run(evidence=evidence)
        self.assertEqual(completed.returncode, 2)
        self.assertBlocked(payload, "CI_NOT_SUCCESS")
        self.assertIn("evidence.ci", payload["verification"]["simulated"])
        self.assertIn("github_ci", payload["verification"]["real_world_not_verified"])

    def test_simulated_ancestry_failure(self) -> None:
        evidence = copy.deepcopy(self.fx.evidence)
        evidence["ancestry"]["ancestor"] = False
        completed, payload = self.fx.run(evidence=evidence)
        self.assertEqual(completed.returncode, 2)
        self.assertBlocked(payload, "ANCESTRY_NOT_VERIFIED")

    def test_unknown_environment(self) -> None:
