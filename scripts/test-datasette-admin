#!/usr/bin/env python3
"""Unit tests for the Datasette admin policy (no Datasette or Podman needed)."""
from __future__ import annotations

import json
import os
import sqlite3
import sys
import tempfile
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "infra" / "datasette-admin"))

os.environ.setdefault("VPS_ADMIN_ACTOR", "test-owner")
os.environ.setdefault("VPS_ADMIN_SESSION", "test-session")
import policy  # noqa: E402


class PolicyTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        self.audit = str(Path(self.temp.name) / "audit.jsonl")
        self.db = sqlite3.connect(str(Path(self.temp.name) / "policy.db"))
        self.addCleanup(self.db.close)
        self.db.executescript(
            """
            CREATE TABLE movimientos(id INTEGER PRIMARY KEY, importe TEXT NOT NULL);
            CREATE TABLE audit(id INTEGER PRIMARY KEY, entidad TEXT NOT NULL, detalle TEXT);
            CREATE TABLE owner(id INTEGER PRIMARY KEY, password TEXT, secret TEXT);
            CREATE TABLE schema_version(version INTEGER PRIMARY KEY);
            CREATE TRIGGER mov_audit AFTER INSERT ON movimientos
            BEGIN INSERT INTO audit(entidad, detalle) VALUES ('movimientos','insert'); END;
            INSERT INTO schema_version(version) VALUES (27);
            INSERT INTO owner(id,password,secret) VALUES (1,'hash','secret');
            """
        )

    def install(self, maintenance=False):
        policy.install(self.db, "poc", maintenance=maintenance, audit_path=self.audit)

    def assertDenied(self, sql):
        with self.assertRaises(sqlite3.DatabaseError):
            self.db.execute(sql)

    def test_business_dml_and_trigger_audit(self):
        self.install()
        self.db.execute("INSERT INTO movimientos(importe) VALUES ('10.00')")
        self.assertEqual(
            self.db.execute("SELECT count(*) FROM audit").fetchone()[0], 1
        )
        self.db.execute("UPDATE movimientos SET importe='11.00' WHERE id=1")
        self.assertEqual(
            self.db.execute("SELECT importe FROM movimientos").fetchone()[0], "11.00"
        )

    def test_habitual_denies_protected_dml(self):
        self.install()
        self.assertDenied("INSERT INTO audit(entidad) VALUES ('x')")
        self.assertDenied("UPDATE audit SET detalle='x' WHERE id=1")
        self.assertDenied("DELETE FROM audit WHERE id=1")
        self.assertDenied("INSERT INTO owner(password,secret) VALUES ('x','y')")
        self.assertDenied("UPDATE owner SET password='x' WHERE id=1")
        self.assertDenied("INSERT INTO schema_version(version) VALUES (28)")

    def test_maintenance_allows_protected_but_not_audit_mutation_or_schema(self):
        self.install(maintenance=True)
        self.db.execute("INSERT INTO audit(entidad,detalle) VALUES ('x','manual')")
        self.assertDenied("UPDATE audit SET detalle='changed' WHERE id=1")
        self.assertDenied("DELETE FROM audit WHERE id=1")
        self.assertDenied("INSERT INTO schema_version(version) VALUES (28)")
        self.assertDenied("UPDATE schema_version SET version=28")

    def test_ddl_and_attach_denied(self):
        self.install()
        self.assertDenied("CREATE TABLE blocked(id INTEGER)")
        self.assertDenied("ALTER TABLE movimientos ADD COLUMN extra TEXT")
        self.assertDenied("ATTACH DATABASE '/tmp/side.db' AS side")
        self.assertDenied("PRAGMA foreign_keys=OFF")
        self.assertDenied("PRAGMA journal_mode=DELETE")
        self.assertDenied("PRAGMA page_size=8192")
        self.assertDenied("CREATE VIRTUAL TABLE vt USING fts5(content)")
        self.db.execute("PRAGMA table_info(movimientos)")
        self.db.execute("PRAGMA schema_version")

    def test_schema_and_user_version_writes_denied(self):
        self.install(maintenance=True)
        self.assertDenied("PRAGMA schema_version=99")
        self.assertDenied("PRAGMA user_version=99")
        self.assertDenied("PRAGMA application_id=99")
        self.assertDenied("PRAGMA query_only=ON")
        self.db.execute("PRAGMA schema_version")

    def test_unknown_table_and_audit_replace_denied(self):
        # DDL is blocked after install, so create the unknown table before install.
        self.db.close()
        self.db = sqlite3.connect(str(Path(self.temp.name) / "policy.db"))
        self.db.execute("CREATE TABLE unknown_table(id INTEGER)")
        self.install()
        self.assertDenied("INSERT INTO unknown_table(id) VALUES (1)")
        with self.assertRaises(ValueError):
            policy.validate_write_sql("INSERT OR REPLACE INTO audit(entidad) VALUES ('x')")
        with self.assertRaises(ValueError):
            policy.validate_write_sql("WITH x AS (SELECT 1) INSERT INTO audit(entidad) VALUES ('x')")
        with self.assertRaises(ValueError):
            policy.validate_write_sql("VACUUM INTO '/tmp/x.db'")

    def test_pragmas_are_set(self):
        self.db.execute("PRAGMA foreign_keys=ON")
        self.db.execute("PRAGMA journal_mode=WAL")
        self.install()
        self.assertEqual(self.db.execute("PRAGMA foreign_keys").fetchone()[0], 1)
        self.assertEqual(
            self.db.execute("PRAGMA recursive_triggers").fetchone()[0], 1
        )
        self.assertEqual(self.db.execute("PRAGMA busy_timeout").fetchone()[0], 3000)
        self.assertEqual(self.db.execute("PRAGMA synchronous").fetchone()[0], 2)
        self.assertEqual(
            self.db.execute("PRAGMA journal_mode").fetchone()[0].lower(), "wal"
        )

    def test_audit_log_has_no_values(self):
        self.install()
        self.db.execute("INSERT INTO movimientos(importe) VALUES ('987.65')")
        with open(self.audit, encoding="utf-8") as handle:
            records = [json.loads(line) for line in handle if line.strip()]
        self.assertTrue(records)
        self.assertEqual(records[0]["actor"], "test-owner")
        self.assertEqual(records[0]["session"], "test-session")
        self.assertEqual(records[0]["op"], "INSERT")
        self.assertEqual(len(records[0]["sha256"]), 64)
        self.assertNotIn("987.65", json.dumps(records))

    def test_sensitive_columns_are_masked(self):
        self.assertTrue(policy.is_sensitive("owner", "password"))
        self.assertTrue(policy.is_sensitive("sessions", "csrf"))
        self.assertFalse(policy.is_sensitive("movimientos", "importe"))
        self.assertEqual(policy.masked("secret"), "••••")
        self.assertIsNone(policy.masked(None))


if __name__ == "__main__":
    unittest.main(verbosity=2)
